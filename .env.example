SECRET_KEY=change..._key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,sitio.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://sitio.com

DB_NAME=db_name
DB_USER=db_user
DB_PASSWORD=db_pass
DB_HOST=localhost
DB_PORT=5432

WAGTAILADMIN_BASE_URL=http://localhost:8000
WAGTAIL_SITE_NAME=Site Name

AWS_ACCESS_KEY_ID=key_id
AWS_SECRET_ACCESS_KEY=access_key
AWS_STORAGE_BUCKET_NAME=bucket-name
AWS_S3_ENDPOINT_URL=https://s3.example.com
AWS_S3_REGION_NAME=auto
AWS_DEFAULT_ACL=public-read
AWS_QUERYSTRING_AUTH=auth_string

STATIC_LOCATION=static
AWS_S3_CUSTOM_DOMAIN=custom.domain.com

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=user@sitio.com
EMAIL_HOST_PASSWORD=email_pass
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@sitio.com

SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https